{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/protect-approved-tests.js" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)"]
  }
}
