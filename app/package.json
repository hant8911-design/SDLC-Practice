{
  "name": "leaveflow",
  "version": "1.1.0",
  "description": "LeaveFlow - ứng dụng quản lý đơn nghỉ phép mini, minh họa quy trình Agentic SDLC",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "node scripts/lint.js",
    "test": "node --test tests/unit/*.test.js tests/api/*.test.js tests/characterization/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/api/*.test.js",
    "test:char": "node --test tests/characterization/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.js tests/api/*.test.js tests/characterization/*.test.js",
    "test:mutation": "node scripts/mutation.js",
    "scan": "node scripts/scan.js",
    "approved-tests": "node scripts/approved-tests.js check",
    "test:report": "node scripts/run-tests.js"
  },
  "license": "MIT"
}
